{
  "name": "jp-reading",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Read Japanese with tap-to-look-up dictionary, furigana, audio and SRS flashcards. A PWA hosted on Cloudflare Workers.",
  "scripts": {
    "dev": "pnpm run build:content && vp dev",
    "data": "node scripts/build-dict.mjs",
    "build:content": "vpx scripts/build-content.ts",
    "audit": "vpx scripts/audit-content.ts",
    "build": "pnpm run build:content && tsc --noEmit && vp build",
    "build:cf": "(git rev-parse --is-shallow-repository | grep -q true && git fetch --unshallow --quiet); pnpm run data && pnpm run build",
    "preview": "vp preview",
    "deploy": "wrangler deploy",
    "test": "vp test run",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint"
  },
  "dependencies": {
    "@patdx/kuromoji": "^1.0.4",
    "@preact/signals": "^2.11.3",
    "idb": "^8.0.4",
    "marked": "^18.1.1",
    "preact": "^11.0.2",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "@types/sax": "^1.2.7",
    "@types/wanakana": "^5.0.0",
    "sax": "^1.6.1",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plus": "catalog:",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.151.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
